---
import "@fontsource/ibm-plex-mono/400.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Personal website of Michael S., featuring projects, blog posts, and social links."
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Michael S. - zekurio.me</title>
    <style is:global>
      :root {
        /* Catppuccin Frappé */
        --bg: #303446; /* base */
        --text: #c6d0f5; /* text — headings */
        --fg: #c6d0f5; /* text — body copy, kept bright for readability */
        --overlay: #a5adce; /* subtext0 — secondary labels */
        --comment: #838ba7; /* overlay1 — muted */
        --red: #e78284;
        --orange: #ef9f76; /* peach */
        --yellow: #e5c890;
        --green: #a6d189;
        --cyan: #81c8be; /* teal */
        --blue: #8caaee;
        --purple: #ca9ee6; /* mauve */
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background-color: var(--bg);
        color: var(--fg);
        font-family: "IBM Plex Mono", monospace;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      a {
        color: var(--fg);
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
