---
import Base from "../layouts/Base.astro";

const langColors = {
    astro: "var(--pink)",
    c: "var(--blue)",
    cpp: "var(--purple)",
    csharp: "var(--green)",
    css: "var(--sapphire)",
    dart: "var(--sky)",
    go: "var(--cyan)",
    html: "var(--orange)",
    java: "var(--red)",
    javascript: "var(--yellow)",
    kotlin: "var(--pink)",
    nix: "var(--purple)",
    php: "var(--lavender)",
    python: "var(--yellow)",
    ruby: "var(--red)",
    rust: "var(--orange)",
    shell: "var(--green)",
    svelte: "var(--orange)",
    swift: "var(--orange)",
    typescript: "var(--blue)",
    vue: "var(--green)",
    zig: "var(--yellow)",
} as const;

type Language = keyof typeof langColors;

interface Project {
    name: string;
    description: string;
    url: string;
    language: Language;
}

const projects: Project[] = [
    {
        name: "alloy",
        description: "open-source and self-hostable alternative to Medal.tv",
        url: "https://github.com/zekurio/alloy",
        language: "typescript",
    },
    {
        name: "anvil",
        description: "an ab-av1 orchestrator daemon for use in a homelab",
        url: "https://github.com/zekurio/anvil",
        language: "go",
    },
    {
        name: "blitzcrank",
        description: "a support agent for my homelab - built on top of Pi",
        url: "https://github.com/zekurio/blitzcrank",
        language: "go",
    },
    {
        name: "jellything",
        description: "self-hosted user management and invitations for Jellyfin",
        url: "https://github.com/zekurio/jellything",
        language: "typescript",
    },
    {
        name: "zugluft",
        description: "native rust fan-control tool for windows",
        url: "https://github.com/zekurio/zugluft",
        language: "rust",
    },
];
---

<Base>
    <main class="projects-page">
        <header class="projects-header">
            <h1 class="page-title">projects</h1>
            <p class="subtitle">a few things i've been working on.</p>
        </header>

        <ul class="project-list">
            {
                projects.map((project) => (
                    <li>
                        <a
                            href={project.url}
                            class="project-row"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <div class="row-main">
                                <span class="project-name">{project.name}</span>
                                <span class="project-desc">
                                    {project.description}
                                </span>
                            </div>
                            <span
                                class="lang-tag"
                                style={`--lang-color: ${langColors[project.language]};`}
                            >
                                <span class="lang-dot" />
                                <span class="lang-name">
                                    {project.language}
                                </span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <footer class="back">
            <a href="/">← back</a>
        </footer>
    </main>
</Base>

<style>
    .projects-page {
        width: 100%;
        max-width: 40rem;
        text-align: left;
    }

    .projects-header {
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 400;
        color: var(--text);
        line-height: 1.4;
        margin-bottom: 0.25rem;
    }

    .subtitle {
        font-size: 0.875rem;
        color: var(--fg);
        line-height: 1.4;
    }

    .project-list {
        list-style: none;
        margin: 0 0 2rem;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    .project-list li + li {
        border-top: 1px solid var(--border);
    }

    .project-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 0;
        color: var(--fg);
        transition: opacity 0.2s ease;
    }

    .project-row:hover {
        opacity: 0.7;
    }

    .row-main {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .project-name {
        color: var(--text);
        font-size: 1rem;
        line-height: 1.4;
    }

    .project-desc {
        color: var(--fg);
        font-size: 0.825rem;
        line-height: 1.45;
    }

    .lang-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
        color: var(--overlay);
        font-size: 0.8rem;
    }

    .lang-dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background-color: var(--lang-color);
    }

    .back {
        color: var(--overlay);
        font-size: 0.875rem;
    }

    .back a {
        color: var(--overlay);
        transition: color 0.2s ease;
    }

    .back a:hover {
        color: var(--text);
    }
</style>
