---
import Base from "../layouts/Base.astro";
import { languageColors } from "../data/language-colors";

interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  fork: boolean;
}

interface Project {
  name: string;
  description: string;
  url: string;
  platform: "github" | "codeberg" | "forgejo" | "gitea" | "gitlab";
  language: string;
  stars: number;
}

// Fetch GitHub repos at build time
let githubProjects: Project[] = [];
try {
  const res = await fetch(
    "https://api.github.com/users/zekurio/repos?sort=updated&per_page=100&type=owner",
    { headers: { "Accept": "application/vnd.github.v3+json" } }
  );
  if (res.ok) {
    const repos: GitHubRepo[] = await res.json();
    githubProjects = repos
      .filter((r) => !r.fork)
      .map((r) => ({
        name: r.name,
        description: r.description || "",
        url: r.html_url,
        platform: "github",
        language: (r.language || "unknown").toLowerCase(),
        stars: r.stargazers_count,
      }));
  }
} catch {
  // Network error — fall through to empty state
}

