const starSvg =
  '<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z"/>';
---

<Base>
  <main>
    <header>
      <h1 class="page-title">projects</h1>
      <p class="subtitle">things i have built, broken, and occasionally fixed.</p>
    </header>

    {
      githubProjects.length > 0 ? (
        <div class="project-grid">
          {githubProjects.map((project) => {
            const langColor = languageColors[project.language] || languageColors.unknown;
            const platformSvg = platformSvgs[project.platform] || platformSvgs.github;
            return (
              <a href={project.url} class="project-card" target="_blank" rel="noopener noreferrer">
                <div class="card-header">
                  <span class="project-name">{project.name}</span>
                  <svg class="platform-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={platformSvg} />
                </div>
                <p class="project-desc">{project.description}</p>
                <div class="card-footer">
                  <span class="lang-tag">
                    <span class="lang-dot" style={`background-color: ${langColor}`} />
                    <span class="lang-name">{project.language}</span>
                  </span>
                  <span class="stars">
                    <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={starSvg} />
                    <span>{project.stars}</span>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty">
          <p>could not load projects.</p>
          <p class="empty-hint">github api may be rate-limited. try again later.</p>
        </div>
      )
    }

    <footer class="back">
      <a href="/">← back</a>
    </footer>
  </main>
</Base>

<style>
  main {
    width: 100%;
    max-width: 44rem;
    text-align: left;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 400;
    color: #fff;
    letter-spacing: 0;
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    font-size: 0.875rem;
    color: var(--comment);
    margin-bottom: 2.5rem;
    line-height: 1.4;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background-color: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(171, 178, 191, 0.08);
    border-radius: 0.5rem;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .project-card:hover {
    border-color: rgba(97, 175, 239, 0.35);
    background-color: rgba(0, 0, 0, 0.22);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-name {
    font-size: 1rem;
    color: #fff;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .platform-icon {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--comment);
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .project-card:hover .platform-icon {
    color: var(--fg);
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--comment);
    line-height: 1.6;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(171, 178, 191, 0.06);
  }

  .lang-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--comment);
  }

  .lang-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .lang-name {
    text-transform: lowercase;
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--comment);
  }

  .star-icon {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--yellow);
  }

  .empty {
    margin-bottom: 3rem;
    padding: 2rem 0;
    color: var(--comment);
    font-size: 0.875rem;
  }

  .empty-hint {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--comment);
    opacity: 0.7;
  }

  .back {
    font-size: 0.875rem;
    color: var(--comment);
  }

  .back a {
    color: var(--comment);
    transition: color 0.2s ease;
  }

  .back a:hover {
    color: var(--fg);
  }
</style>
