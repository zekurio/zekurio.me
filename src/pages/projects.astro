---
import Base from "../layouts/Base.astro";

interface Project {
  name: string;
  description: string;
  url: string;
  language: string;
  langColor: string;
}

const projects: Project[] = [
  {
    name: "alloy",
    description: "open-source and self-hostable alternative to Medal.tv",
    url: "https://github.com/zekurio/alloy",
    language: "typescript",
    langColor: "#8caaee",
  },
  {
    name: "blitzcrank",
    description: "a support agent for my homelab — built on top of Pi",
    url: "https://github.com/zekurio/blitzcrank",
    language: "go",
    langColor: "#81c8be",
  },
  {
    name: "nix",
    description: "my nix config — use at own risk",
    url: "https://github.com/zekurio/nix",
    language: "nix",
    langColor: "#ca9ee6",
  },
];
---

<Base>
  <main class="projects-page">
    <header class="projects-header">
      <h1 class="page-title">projects</h1>
      <p class="subtitle">a few things i've been working on.</p>
    </header>

    <ul class="project-list">
      {
        projects.map((project) => (
          <li>
            <a
              href={project.url}
              class="project-row"
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="row-main">
                <span class="project-name">{project.name}</span>
                <span class="project-desc">{project.description}</span>
              </div>
              <span class="lang-tag" style={`--lang-color: ${project.langColor};`}>
                <span class="lang-dot" />
                <span class="lang-name">{project.language}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer class="back">
      <a href="/">← back</a>
    </footer>
  </main>
</Base>

<style>
  .projects-page {
    width: 100%;
    max-width: 40rem;
    text-align: left;
  }

  .projects-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    font-size: 0.875rem;
    color: var(--fg);
    line-height: 1.4;
  }

  .project-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .project-list li + li {
    border-top: 1px solid rgba(198, 208, 245, 0.08);
  }

  .project-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    color: var(--fg);
    transition: opacity 0.2s ease;
  }

  .project-row:hover {
    opacity: 0.7;
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .project-name {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.4;
  }

  .project-desc {
    color: var(--fg);
    font-size: 0.825rem;
    line-height: 1.45;
  }

  .lang-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    color: var(--overlay);
    font-size: 0.8rem;
  }

  .lang-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background-color: var(--lang-color);
  }

  .back {
    color: var(--overlay);
    font-size: 0.875rem;
  }

  .back a {
    color: var(--overlay);
    transition: color 0.2s ease;
  }

  .back a:hover {
    color: var(--text);
  }
</style>
