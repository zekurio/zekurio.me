---
import BackLink from "../components/BackLink.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { langColors, projects } from "../lib/projects";
---

<Base>
    <main class="projects-page">
        <PageHeader
            title="projects"
            subtitle="a few things i've been working on."
        />

        <ul class="project-list">
            {projects.map((project) => (
                <li>
                    <a
                        href={project.url}
                        class="project-row"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <div class="row-main">
                            <span class="project-name">{project.name}</span>
                            <span class="project-desc">
                                {project.description}
                            </span>
                        </div>
                        <span
                            class="lang-tag"
                            style={`--lang-color: ${langColors[project.language]};`}
                        >
                            <span class="lang-dot" />
                            <span class="lang-name">{project.language}</span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>

        <BackLink href="/">back</BackLink>
    </main>
</Base>

<style>
    .projects-page {
        width: 100%;
        max-width: 40rem;
        text-align: left;
    }

    .project-list {
        list-style: none;
        display: flex;
        flex-direction: column;
    }

    .project-list li + li {
        border-top: 1px solid var(--border);
    }

    .project-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 0;
        color: var(--fg);
        transition: opacity 0.2s ease;
    }

    .project-row:hover {
        opacity: 0.7;
    }

    .row-main {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .project-name {
        color: var(--text);
        font-size: 1rem;
        line-height: 1.4;
    }

    .project-desc {
        color: var(--fg);
        font-size: 0.825rem;
        line-height: 1.45;
    }

    .lang-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
        color: var(--overlay);
        font-size: 0.8rem;
    }

    .lang-dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background-color: var(--lang-color);
    }
</style>
