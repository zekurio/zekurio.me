---
import BackLink from "../../components/BackLink.astro";
import Base from "../../layouts/Base.astro";
import { homelabSystems, specRows } from "../../lib/homelab";
import type { HomelabSystem } from "../../lib/homelab";

export async function getStaticPaths() {
    return homelabSystems.map((system) => ({
        params: { slug: system.name },
        props: { system },
    }));
}

const { system } = Astro.props as { system: HomelabSystem };
const rows = specRows(system);
---

<Base>
    <main class="system-page">
        <article>
            <header>
                <h1 class="system-title">{system.name}</h1>
                <p class="description">{system.description}</p>
            </header>

            <div class="divider"></div>

            <section class="spec-sheet" aria-labelledby="spec-heading">
                <h2 id="spec-heading">specs</h2>
                <dl>
                    {rows.map((row) => (
                        <div class="spec-row">
                            <dt>{row.label}</dt>
                            <dd>
                                {row.entries.map((entry) => (
                                    <span class="spec-entry">
                                        {entry.label ? (
                                            <span class="spec-sub">
                                                {entry.label} ·{" "}
                                            </span>
                                        ) : null}
                                        {entry.value}
                                    </span>
                                ))}
                            </dd>
                        </div>
                    ))}
                </dl>
            </section>
        </article>

        <BackLink href="/homelab">all systems</BackLink>
    </main>
</Base>

<style>
    .system-page {
        width: 100%;
        max-width: 42rem;
        text-align: left;
    }

    .system-title {
        color: var(--text);
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.4;
        margin-bottom: 0.5rem;
    }

    .description {
        color: var(--comment);
        font-size: 0.875rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .divider {
        height: 1px;
        background-color: var(--divider);
        margin-bottom: 2rem;
    }

    .spec-sheet h2 {
        margin-bottom: 0.85rem;
        color: var(--comment);
        font-size: 0.8rem;
        font-weight: 400;
        line-height: 1.4;
    }

    .spec-sheet dl {
        display: flex;
        flex-direction: column;
    }

    .spec-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.6rem 0;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .spec-row + .spec-row {
        border-top: 1px solid var(--border);
    }

    .spec-row dt {
        flex-shrink: 0;
        color: var(--comment);
    }

    .spec-row dd {
        min-width: 0;
        color: var(--fg);
        text-align: right;
    }

    .spec-entry {
        display: block;
    }

    .spec-entry + .spec-entry {
        margin-top: 0.35rem;
    }

    .spec-sub {
        color: var(--comment);
    }
</style>
