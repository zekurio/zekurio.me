---
import Base from "../layouts/Base.astro";
---

<Base>
  <main>
    <header>
      <h1 class="name">michael s.</h1>
      <p class="subtitle">
        <span class="typing-text"></span><span class="cursor">_</span>
      </p>
    </header>

    <nav class="links">
      <a href="/projects" class="link-row">
        <span>projects</span>
      </a>
      <a href="/blog" class="link-row">
        <span>blog</span>
      </a>
    </nav>

    <footer class="socials">
      <a
        href="https://github.com/zekurio"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="github"
      >
        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .297c-6.63 0-12 5.373-12 12c0 5.303 3.438 9.8 8.205 11.385c.6.113.82-.258.82-.577c0-.285-.01-1.04-.015-2.04c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729c1.205.084 1.838 1.236 1.838 1.236c1.07 1.835 2.809 1.305 3.495.998c.108-.776.417-1.305.76-1.605c-2.665-.3-5.466-1.332-5.466-5.93c0-1.31.465-2.38 1.235-3.22c-.135-.303-.54-1.523.105-3.176c0 0 1.005-.322 3.3 1.23c.96-.267 1.98-.399 3-.405c1.02.006 2.04.138 3 .405c2.28-1.552 3.285-1.23 3.285-1.23c.645 1.653.24 2.873.12 3.176c.765.84 1.23 1.91 1.23 3.22c0 4.61-2.805 5.625-5.475 5.92c.42.36.81 1.096.81 2.22c0 1.606-.015 2.896-.015 3.286c0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          />
        </svg>
      </a>
      <a
        href="https://x.com/zekurio1337"
        class="social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="x"
      >
        <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M14.234 10.162L22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299l-.929-1.329L3.076 1.56h3.182l5.965 8.532l.929 1.329l7.754 11.09h-3.182z"
          />
        </svg>
      </a>
    </footer>
  </main>
</Base>

<script>
  const texts = [
    "often builds things.",
    "breaks lots of things.",
    "sometimes fixes things.",
  ];
  const el = document.querySelector(".typing-text");
  let i = 0;
  let char = 0;
  let deleting = false;

  function type() {
    const text = texts[i];
    if (deleting) {
      el.textContent = text.slice(0, char--);
      if (char < 0) {
        deleting = false;
        i = (i + 1) % texts.length;
        char = 0;
        setTimeout(type, 350);
        return;
      }
    } else {
      el.textContent = text.slice(0, char++);
      if (char > text.length) {
        deleting = true;
        setTimeout(type, 2200);
        return;
      }
    }
    setTimeout(type, deleting ? 35 : 75);
  }

  type();
</script>

<style>
  main {
    width: 100%;
    max-width: 20rem;
    text-align: left;
  }

  .name {
    font-size: 1.375rem;
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .subtitle {
    font-size: 0.875rem;
    color: var(--comment);
    margin-bottom: 2.5rem;
    line-height: 1.4;
    min-height: 1.4em;
  }

  .typing-text {
    color: var(--fg);
  }

  .cursor {
    display: inline-block;
    color: var(--blue);
    margin-left: 0.05em;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .link-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: var(--fg);
    position: relative;
    width: fit-content;
    transition: color 0.2s ease;
  }

  .link-row::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--blue);
    transition: width 0.25s ease;
  }

  .link-row:hover {
    color: #fff;
  }

  .link-row:hover::after {
    width: 100%;
  }

  .external {
    width: 0.75rem;
    height: 0.75rem;
    opacity: 0;
    transform: translateY(1px);
    transition: opacity 0.2s ease;
  }

  .link-row:hover .external {
    opacity: 1;
  }

  .socials {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    color: var(--comment);
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--fg);
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
  }
</style>
