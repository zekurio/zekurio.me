---
import Base from "../layouts/Base.astro";
---

<Base>
  <main>
    <h1 class="headline">Michael S.</h1>
    <p class="disclaimer">[wip]</p>
  </main>
</Base>

<style>
  main {
    text-align: center;
  }

  .headline {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 700;
    color: var(--blue);
    letter-spacing: -0.02em;
  }

  .disclaimer {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--comment);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
