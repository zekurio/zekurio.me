---
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const postModules = import.meta.glob("../../content/posts/*.md", { eager: true });
  const paths = [];
  for (const path in postModules) {
    const mod = postModules[path];
    const slug = path.split("/").pop().replace(".md", "");
    paths.push({
      params: { slug },
      props: { post: mod },
    });
  }
  return paths;
}

const { post } = Astro.props;
const date = new Date(post.frontmatter.date);
const dateStr = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const slug = post.file.split("/").pop().replace(".md", "");
---

<Base>
  <main>
    <article>
      <header>
        <h1 class="post-title" transition:name={`post-${slug}`}>{post.frontmatter.title}</h1>
        <time class="post-date">{dateStr}</time>
      </header>

      <div class="divider"></div>

      <div class="content" set:html={post.compiledContent()} />
    </article>

    <footer class="back">
      <a href="/blog">← all posts</a>
    </footer>
  </main>
</Base>

<style>
  main {
    width: 100%;
    max-width: 42rem;
    text-align: left;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 400;
    color: #fff;
    letter-spacing: 0;
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .post-date {
    display: block;
    font-size: 0.875rem;
    color: var(--comment);
    margin-bottom: 1.5rem;
  }

  .divider {
    height: 1px;
    background-color: rgba(171, 178, 191, 0.15);
    margin-bottom: 2rem;
  }

  .content :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }

  .content :global(p:last-child) {
    margin-bottom: 0;
  }

  .content :global(a) {
    color: var(--blue);
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }

  .content :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .content :global(strong) {
    color: #fff;
    font-weight: 700;
  }

  .content :global(em) {
    font-style: italic;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.75;
  }

  .content :global(code) {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.875em;
    background-color: rgba(171, 178, 191, 0.08);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  .content :global(pre) {
    margin-bottom: 1.25rem;
    padding: 1rem;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 0.375rem;
    overflow-x: auto;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
  }

  .content :global(h2),
  .content :global(h3) {
    color: #fff;
    font-weight: 400;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .content :global(h2) {
    font-size: 1.25rem;
  }

  .content :global(h3) {
    font-size: 1.1rem;
  }

  .content :global(blockquote) {
    border-left: 2px solid var(--blue);
    padding-left: 1rem;
    margin-bottom: 1.25rem;
    color: var(--fg);
  }

  .back {
    margin-top: 3rem;
    font-size: 0.875rem;
    color: var(--comment);
  }

  .back a {
    color: var(--comment);
    transition: color 0.2s ease;
  }

  .back a:hover {
    color: var(--fg);
  }
</style>
