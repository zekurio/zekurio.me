---
import BackLink from "../components/BackLink.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { formatPostDate, postSlug, posts } from "../lib/posts";
---

<Base>
    <main class="blog-page">
        <PageHeader
            title="blog"
            subtitle="thoughts on hardware, software and other things."
        />

        <nav class="post-list">
            {posts.map((post) => (
                <a href={`/blog/${postSlug(post)}`} class="post-row">
                    <span class="post-title">{post.frontmatter.title}</span>
                    <span class="post-date">
                        {formatPostDate(post, "short")}
                    </span>
                </a>
            ))}
        </nav>

        <BackLink href="/">back</BackLink>
    </main>
</Base>

<style>
    .blog-page {
        width: 100%;
        max-width: 42rem;
        text-align: left;
    }

    .post-list {
        display: flex;
        flex-direction: column;
    }

    .post-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.875rem 0;
        font-size: 1rem;
        color: var(--fg);
        border-bottom: 1px solid var(--border);
        position: relative;
        transition: color 0.2s ease;
    }

    .post-row::after {
        content: "";
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 0;
        height: 1px;
        background-color: var(--accent);
        transition: width 0.25s ease;
    }

    .post-row:hover {
        color: var(--text);
    }

    .post-row:hover::after {
        width: 100%;
    }

    .post-title {
        flex: 1;
        min-width: 0;
    }

    .post-date {
        font-size: 0.875rem;
        color: var(--comment);
        white-space: nowrap;
        flex-shrink: 0;
        transition: color 0.2s ease;
    }

    .post-row:hover .post-date {
        color: var(--fg);
    }
</style>
