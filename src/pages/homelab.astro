---
import BackLink from "../components/BackLink.astro";
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { homelabSystems } from "../lib/homelab";
---

<Base>
    <main class="homelab-page">
        <PageHeader
            title="homelab"
            subtitle="systems currently in use and what's in them."
        />

        <nav class="system-list" aria-label="homelab systems">
            {homelabSystems.map((system) => (
                <a href={`/homelab/${system.name}`} class="system-row">
                    <span class="system-main">
                        <span class="system-title">{system.name}</span>
                        <span class="system-desc">{system.description}</span>
                    </span>
                </a>
            ))}
        </nav>

        <BackLink href="/">back</BackLink>
    </main>
</Base>

<style>
    .homelab-page {
        width: 100%;
        max-width: 40rem;
        text-align: left;
    }

    .system-list {
        display: flex;
        flex-direction: column;
    }

    .system-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 0;
        color: var(--fg);
        transition: opacity 0.2s ease;
    }

    .system-row + .system-row {
        border-top: 1px solid var(--border);
    }

    .system-row:hover {
        opacity: 0.7;
    }

    .system-main {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .system-title {
        color: var(--text);
        font-size: 1rem;
        line-height: 1.4;
    }

    .system-desc {
        color: var(--fg);
        font-size: 0.825rem;
        line-height: 1.45;
    }
</style>
