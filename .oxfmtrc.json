{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    ".astro/**",
    ".direnv/**",
    ".git/**",
    ".pnpm-home/**",
    ".wrangler/**",
    "dist/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "worker-configuration.d.ts"
  ]
}
