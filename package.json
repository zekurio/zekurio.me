{
  "name": "zekurio-me",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro preview --host 0.0.0.0 --port ${PORT:-4321}",
    "build": "astro build",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "pnpm run build && wrangler dev",
    "generate-types": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.109",
    "@iconify-json/simple-icons": "^1.2.83",
    "astro": "^6.4.6",
    "astro-icon": "^1.1.5"
  },
  "devDependencies": {
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "wrangler": "^4.107.0"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "js-yaml": "^4.2.0",
      "tar": "^7.5.16",
      "undici": "^7.28.0",
      "vite": "^7.3.5",
      "ws": "^8.21.0"
    }
  }
}
